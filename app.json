{
  "expo": {
    "scheme": "cybergame",
    "name": "CyberGame",
    "slug": "CyberGame",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050d1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cybergame.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050d1a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cybergame.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}